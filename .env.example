GEMINI_API_KEY=            # Google AI Studio key (free tier available)
GEMINI_MODEL=            # optional; blank = auto-pick the newest stable Gemini flash your key can use
# Moomoo OpenD is a local desktop app (TCP). Used by the Claude Code skills.
OPEND_HOST=127.0.0.1
OPEND_PORT=11111
# Local read-only bridge to OpenD (see bridge/opend_bridge.py)
BRIDGE_TOKEN=            # required by bridge/opend_bridge.py
BRIDGE_ALLOW_ORIGIN=     # your deployed site origin (optional)
BRIDGE_ALLOW_REAL=       # set 1 to allow REAL account reads
# Optional: if set, /api/analyze requires header x-access-token (protects your Gemini quota on a public URL)
ACCESS_TOKEN=
# Site usage tab (/api/analytics), Vercel only. A Vercel access token that can read this project's Web
# Analytics (vercel.com/account/tokens). Needs Web Analytics enabled on the project (Analytics tab -> Enable).
# Without it the Usage tab just shows setup instructions.
VERCEL_ANALYTICS_TOKEN=
VERCEL_ANALYTICS_PROJECT_ID=     # optional; defaults to the auto-set VERCEL_PROJECT_ID
VERCEL_ANALYTICS_TEAM_ID=        # optional; defaults to the auto-set VERCEL_TEAM_ID
ANALYTICS_DAYS=                  # optional; window size in days, default 30, clamped 7-90
