GEMINI_API_KEY=            # Google AI Studio key (free tier available)
GEMINI_MODEL=gemini-1.5-pro
# Moomoo OpenD is a local desktop app (TCP). Used by the Claude Code skills.
OPEND_HOST=127.0.0.1
OPEND_PORT=11111
# Local read-only bridge to OpenD (see bridge/opend_bridge.py)
BRIDGE_TOKEN=            # required by bridge/opend_bridge.py
BRIDGE_ALLOW_ORIGIN=     # your deployed site origin (optional)
BRIDGE_ALLOW_REAL=       # set 1 to allow REAL account reads
# Optional: if set, /api/analyze requires header x-access-token (protects your Gemini quota on a public URL)
ACCESS_TOKEN=
